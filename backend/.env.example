# Copy to backend/.env and adjust. Never commit the real .env (NFR-09).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Read by both Django and the postgres container in the repo-root docker-compose.yml.
# Django assembles the connection from these in config/settings/base.py -- there is no URL.
POSTGRES_DB=tasklane
POSTGRES_USER=tasklane
POSTGRES_PASSWORD=tasklane
# Uploaded profile pictures. MEDIA_ROOT is always backend/media/ (gitignored); Django serves it
# only while DJANGO_DEBUG is on -- production needs a real static server or CDN in front of it.
MEDIA_URL=media/
MAX_AVATAR_KB=10240

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Label shown beside the code inside the authenticator app.
TOTP_ISSUER=Tasklane

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
